# ─── Cert helper ─────────────────────────────────────────────────────────────

import os, subprocess

def gen_default_cert():
    """Auto-generate self-signed cert if not exists"""
    if os.path.exists(DEFAULT_CERT) and os.path.exists(DEFAULT_KEY):
        return True, "existing"

    print(f"  {cyan("[*]")} gen cert — generating self-signed certificate...")
    try:
        # Step 1: generate key + PEM cert
        r1 = subprocess.run([
            "openssl", "req", "-x509", "-newkey", "rsa:2048",
            "-keyout", DEFAULT_KEY,
            "-out", CERT_PEM,
            "-days", "365", "-nodes",
            "-subj", "/CN=AttackerClient/O=CoreFlareSec/C=TH"
        ], capture_output=True)
        if r1.returncode != 0:
            print(f"[-] openssl step1 failed: {r1.stderr.decode()[:100]}")
            return False, "gen_failed"

        # Step 2: convert PEM → DER
        r2 = subprocess.run([
            "openssl", "x509", "-in", CERT_PEM,
            "-outform", "DER", "-out", DEFAULT_CERT
        ], capture_output=True)
        if r2.returncode != 0:
            print(f"[-] openssl step2 failed: {r2.stderr.decode()[:100]}")
            return False, "convert_failed"

        print(f"  {green("[cert]")  } generated: {DEFAULT_CERT} + {DEFAULT_KEY} ✓")
        return True, "generated"

    except FileNotFoundError:
        print(f"[-] openssl not found — install: sudo apt install openssl -y")
        print(f"[*] Manual cert generation:{GEN_CERT_CMD}")
        return False, "openssl_missing"


def get_cert_paths(cert=None, key=None, auto_gen=True):
    """
    Return (cert_path, key_path) — auto-gen if needed
    priority: --cert/--key args → DEFAULT_CERT → auto-gen
    """
    c = cert or DEFAULT_CERT
    k = key  or DEFAULT_KEY

    if os.path.exists(c) and os.path.exists(k):
        return c, k, "existing"

    if auto_gen:
        ok, status = gen_default_cert()
        if ok:
            return DEFAULT_CERT, DEFAULT_KEY, status
        return None, None, status

    return None, None, "not_found"


# ─── Connect helpers ──────────────────────────────────────────────────────────

async def try_connect(url, user="", password="", timeout=5):
    """Anonymous or username/password connect"""
    client = Client(url=url, timeout=timeout)
    client.load_type_definitions = False
    if user:
        client.set_user(user)
        client.set_password(password)
    try:
        await client.connect()
        return client
    except Exception:
        try:
            await client.disconnect()
        except:
            pass
        return None


async def try_connect_cert(url, cert, key, mode_str="sign-encrypt", timeout=5):
    """Certificate-based connect — bypass Trust List"""
    try:
        from asyncua.crypto.security_policies import SecurityPolicyBasic256Sha256
        from asyncua.ua import MessageSecurityMode
    except ImportError:
        print("[-] Missing: pip3 install asyncua[crypto] cryptography")
        return None, None

    mode_map = {
        "sign":         MessageSecurityMode.Sign,
        "sign-encrypt": MessageSecurityMode.SignAndEncrypt,
    }
    mode = mode_map.get(mode_str, MessageSecurityMode.SignAndEncrypt)

    client = Client(url=url, timeout=timeout)
    client.load_type_definitions = False
    try:
        await client.set_security(
            SecurityPolicyBasic256Sha256,
            certificate=cert,
            private_key=key,
            mode=mode
        )
        await client.connect()
        return client, mode_str
    except Exception as e:
        try:
            await client.disconnect()
        except:
            pass
        return None, str(e)


async def auto_connect(url, cert=None, key=None, user="", password="", timeout=5):
    """
    Auto security fallback:
    1. Try anonymous (SecurityPolicy#None)
    2. Auto-gen cert if needed → Try Sign → SignAndEncrypt
    Returns (client, method_used) or (None, error)
    """
    # Step 1: anonymous
    print(f"  {cyan("[*]")} try anonymous...", end=" ", flush=True)
    client = await try_connect(url, user, password, timeout)
    if client:
        print("OK")
        return client, "anonymous"
    print("failed")

    # Step 2-3: cert-based — auto-gen if not exists
    cert_path, key_path, cert_status = get_cert_paths(cert, key, auto_gen=True)
    if not cert_path:
        return None, "cert gen failed"

    print(f"  {cyan("[*]")} using cert [{cert_status}]: {bold(cert_path)}")
    for mode in ["sign", "sign-encrypt"]:
        print(f"[+] try cert mode={mode}...", end=" ", flush=True)
        client, result = await try_connect_cert(url, cert_path, key_path, mode, timeout)
        if client:
            print("OK")
            return client, f"cert/{mode}"
        print(f"failed")

    return None, "all methods failed"

