# ─── Mode 6: Write node ───────────────────────────────────────────────────────

async def mode_write(url, nodeid, value, datatype, user="", password="",
                     cert=None, key=None, security="none"):
    client = await _connect_by_security(url, security, cert, key, user, password)
    if not client:
        print("[-] Connection failed")
        return

    # type conversion
    type_map = {
        "bool":   (lambda v: v.lower() in ("true","1","yes","on"), ua.VariantType.Boolean),
        "int":    (int,   ua.VariantType.Int64),
        "float":  (float, ua.VariantType.Double),
        "double": (float, ua.VariantType.Double),
        "str":    (str,   ua.VariantType.String),
        "string": (str,   ua.VariantType.String),
    }
    conv, vtype = type_map.get(datatype.lower(), (str, ua.VariantType.String))
    try:
        converted = conv(value)
    except Exception as e:
        print(f"[-] Cannot convert value: {e}")
        return

    try:
        node = client.get_node(nodeid)
        old  = await node.read_value()
        await node.write_value(ua.DataValue(ua.Variant(converted, vtype)))
        new  = await node.read_value()
        print(f"\n[+] Written [{nodeid}]")
        print(f"    Before: {repr(old)}")
        print(f"    After:  {repr(new)}")
    except Exception as e:
        print(f"[-] Write failed: {e}")
    finally:
        try:
            await client.disconnect()
        except:
            pass


# ─── Mode 7: Monitor nodes ────────────────────────────────────────────────────

async def mode_monitor(url, nodeids, interval=2, user="", password="",
                       cert=None, key=None, security="none"):
    print(f"\n[*] Monitoring {len(nodeids)} node(s) every {interval}s  (Ctrl+C stop)")
    print(f"{'─'*60}")

    client = await _connect_by_security(url, security, cert, key, user, password)
    if not client:
        print("[-] Connection failed")
        return

    nodes = [client.get_node(nid) for nid in nodeids]
    names = []
    for node in nodes:
        try:
            names.append((await node.read_browse_name()).Name)
        except:
            names.append("?")

    # header
    hdr = f"{'TIME':>10}"
    for name in names:
        hdr += f" | {name[:12]:>12}"
    print(hdr)
    print("─" * (12 + len(nodes)*16))

    prev = {}
    try:
        while True:
            ts  = datetime.now().strftime("%H:%M:%S")
            row = f"{ts:>10}"
            for i, node in enumerate(nodes):
                try:
                    val = await node.read_value()
                    p   = prev.get(i)
                    tag = f"*{val}*" if (p is not None and p != val) else str(val)
                    row += f" | {str(tag)[:12]:>12}"
                    prev[i] = val
                except:
                    row += f" | {'ERR':>12}"
            print(row)
            await asyncio.sleep(interval)
    except KeyboardInterrupt:
        print("\n[*] Monitor stopped")
    finally:
        try:
            await client.disconnect()
        except:
            pass


# ─── Mode 8: Ramp ─────────────────────────────────────────────────────────────

async def mode_ramp(url, nodeid, start, end, step, interval,
                    trip_nodeid=None, threshold=None, user="", password="",
                    cert=None, key=None, security="none"):
    print(f"\n[*] Ramping [{nodeid}] from {start} to {end} step={step} interval={interval}s")
    if trip_nodeid:
        print(f"[*] Trip monitor: [{trip_nodeid}] threshold={threshold}")
    print(f"{'─'*60}")

    client = await _connect_by_security(url, security, cert, key, user, password)
    if not client:
        print("[-] Connection failed")
        return

    try:
        node      = client.get_node(nodeid)
        trip_node = client.get_node(trip_nodeid) if trip_nodeid else None
        val       = float(start)

        print(f"{'Value':>8} | {'Time':>10} | {'Trip/Status':>12}")
        print(f"{'─'*40}")

        while val <= float(end):
            await node.write_value(ua.DataValue(ua.Variant(val, ua.VariantType.Double)))
            ts = datetime.now().strftime("%H:%M:%S")

            status = "OK"
            if trip_node:
                try:
                    trip_val = await trip_node.read_value()
                    if threshold is not None:
                        if isinstance(trip_val, bool):
                            status = "TRIP!" if trip_val else "OK"
                        else:
                            status = "TRIP!" if float(trip_val) >= float(threshold) else f"{trip_val:.2f}"
                except:
                    status = "ERR"

            print(f"{val:>8.1f} | {ts:>10} | {status:>12}")
            if status == "TRIP!":
                print(f"\n[!] Trip at value={val} — stopping")
                break

            val = round(val + float(step), 4)
            await asyncio.sleep(float(interval))

        print(f"\n[*] Ramp complete")

    except KeyboardInterrupt:
        print("\n[*] Ramp stopped")
    except Exception as e:
        print(f"[-] {e}")
    finally:
        try:
            await client.disconnect()
        except:
            pass


# ─── Security connect helper ──────────────────────────────────────────────────

async def _connect_by_security(url, security, cert, key, user, password):
    """Connect using specified security mode"""
    if security == "auto":
        client, method = await auto_connect(url, cert, key, user, password)
        if client:
            print(f"{green("[+]")} Connected {bold(method)}")
        else:
            print(f"{red("[-]")} All methods failed")
        return client

    elif security in ("sign", "sign-encrypt"):
        # auto-gen cert if not specified
        cert_path, key_path, cert_status = get_cert_paths(cert, key, auto_gen=True)
        if not cert_path:
            print(f"[-] Cert required for {security} mode but not available")
            return None
        print(f"[+] Using cert [{cert_status}]: {cert_path}")
        client, result = await try_connect_cert(url, cert_path, key_path, security)
        if client:
            print(f"{green("[+]")} Connected {bold(security)}")
        else:
            print(f"{red("[-]")} Connection failed: {result}")
        return client

    else:  # none (default)
        client = await try_connect(url, user, password)
        if client:
            print(f"{green("[+]")} Connected {bold("none")}")
        return client


# ─── CLI ─────────────────────────────────────────────────────────────────────

def parse_args():
    parser = argparse.ArgumentParser(
        description="OPC UA Recon Tool v2 — CoreFlareSec",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False
    )
    parser.add_argument("url",        nargs="?")
    parser.add_argument("-h","--help",action="store_true")
    parser.add_argument("-m","--mode",default="enum",
        choices=["info","enum","brute","writable","read","write","monitor","ramp"])
    parser.add_argument("-u","--user",      default="")
    parser.add_argument("-p","--password",  default="")
    parser.add_argument("-n","--nodeid",    help="NodeID e.g. ns=2;i=12")
    parser.add_argument("-v","--value",     help="Value to write")
    parser.add_argument("-t","--type",      default="str",
        help="Data type: str, bool, int, float")
    parser.add_argument("-w","--wordlist",  help="Credential wordlist")
    parser.add_argument("-i","--interval",  type=float, default=2)
    parser.add_argument("-o","--output",    help="Save enum to JSON")
    parser.add_argument("--ns",             type=int, default=None)
    parser.add_argument("--monitor-nodes",  nargs="+")
    parser.add_argument("--ramp-start",     type=float, default=0)
    parser.add_argument("--ramp-end",       type=float, default=50)
    parser.add_argument("--ramp-step",      type=float, default=1)
    parser.add_argument("--trip-nodeid",    help="NodeID for trip detection")
    parser.add_argument("--threshold",      type=float)
    # ── Security options (NEW) ──────────────────────────────────
    parser.add_argument("--security",       default="none",
        choices=["none","sign","sign-encrypt","auto"],
        help="Security mode: none/sign/sign-encrypt/auto")
    parser.add_argument("--cert",           help="Path to certificate.der")
    parser.add_argument("--key",            help="Path to private-key.pem")

    args = parser.parse_args()
    if args.help or not args.url:
        print(BANNER)
        print(HELP_TEXT)
        sys.exit(0)
    return args


async def main():
    args = parse_args()

    url      = args.url
    user     = args.user
    pwd      = args.password
    cert     = args.cert
    key      = args.key
    security = args.security

    print(f"[*] Target   : {url}")
    print(f"[*] Mode     : {args.mode}")
    print(f"[*] Security : {security}")
    if cert:
        print(f"[*] Cert     : {cert}")
    if user:
        print(f"[*] Auth     : {user}:{pwd}")
    else:
        print(f"[*] Auth     : anonymous")

    if args.mode == "info":
        await mode_info(url, cert=cert, key=key)

    elif args.mode == "enum":
        await mode_enum(url, user, pwd, args.output, args.ns, cert, key, security)

    elif args.mode == "brute":
        await mode_bruteforce(url, args.wordlist)

    elif args.mode == "writable":
        await mode_writable(url, user, pwd, cert, key, security, ns_filter=args.ns)

    elif args.mode == "read":
        if not args.nodeid:
            print("[-] -n/--nodeid required"); sys.exit(1)
        await mode_read(url, args.nodeid, user, pwd, cert, key, security)

    elif args.mode == "write":
        if not args.nodeid or args.value is None:
            print("[-] -n/--nodeid and -v/--value required"); sys.exit(1)
        await mode_write(url, args.nodeid, args.value, args.type,
                         user, pwd, cert, key, security)

    elif args.mode == "monitor":
        nodes = args.monitor_nodes or []
        if not nodes:
            print("[-] --monitor-nodes required"); sys.exit(1)
        await mode_monitor(url, nodes, args.interval, user, pwd, cert, key, security)

    elif args.mode == "ramp":
        if not args.nodeid:
            print("[-] -n/--nodeid required"); sys.exit(1)
        await mode_ramp(url, args.nodeid,
                        args.ramp_start, args.ramp_end, args.ramp_step,
                        args.interval, args.trip_nodeid, args.threshold,
                        user, pwd, cert, key, security)


if __name__ == "__main__":
    asyncio.run(main())
