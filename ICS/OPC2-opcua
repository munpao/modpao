# ─── Mode 2: Bruteforce ───────────────────────────────────────────────────────

async def mode_bruteforce(url, wordlist=None):
    creds = list(DEFAULT_CREDS)
    if wordlist:
        try:
            with open(wordlist) as f:
                for line in f:
                    parts = line.strip().split(":", 1)
                    creds.append((parts[0], parts[1] if len(parts) > 1 else ""))
        except Exception as e:
            print(f"[-] Cannot read wordlist: {e}")

    print(f"\n[*] Bruteforcing credentials on {url}")
    print(f"{'─'*50}")

    found = []
    for user, pwd in creds:
        label = "anonymous" if not user else f"{user}:{pwd}"
        client = await try_connect(url, user, pwd)
        if client:
            print(f"  {green("[+]")} {green("Found")}  → {bold(label)}")
            found.append((user, pwd))
            await client.disconnect()
        else:
            print(f"  {red("[-]")  } Failed → {label}")

    print(f"\n[*] Found {len(found)} valid credential(s)")
    for u, p in found:
        print(f"  → {u}:{p}" if u else "  → anonymous")
    return found


# ─── Mode 3: Enumerate nodes ─────────────────────────────────────────────────

async def mode_enum(url, user="", password="", output=None, ns_filter=None,
                    cert=None, key=None, security="none"):
    print(f"\n[*] Enumerating nodes on {url}")
    if ns_filter is not None:
        print(f"[*] Namespace filter: ns={ns_filter}")
    print(f"{'─'*50}")

    # connect
    client = await _connect_by_security(url, security, cert, key, user, password)
    if not client:
        print("[-] Connection failed")
        return

    nodes = []

    async def tree_browse(node, prefix="", filter_ns=None):
        try:
            children = await node.get_children()
            for i, child in enumerate(children):
                last = (i == len(children) - 1)
                connector = "└── " if last else "├── "
                try:
                    ns_idx = child.nodeid.NamespaceIndex
                    if filter_ns is not None and ns_idx != filter_ns:
                        await tree_browse(child, prefix + ("    " if last else "│   "), filter_ns)
                        continue

                    name   = (await child.read_browse_name()).Name
                    nodeid = child.nodeid.to_string()
                    try:
                        val      = await child.read_value()
                        datatype = type(val).__name__
                        print(f"{prefix}{connector}{cyan("["+nodeid+"]")} {bold(name)} = {neon(repr(val))}")
                        nodes.append({"nodeid":nodeid,"name":name,"value":str(val),
                                      "type":datatype,"ns":ns_idx,"writable":None})
                    except:
                        print(f"{prefix}{connector}{cyan("["+nodeid+"]")} {blue(name+"/")}")
                        nodes.append({"nodeid":nodeid,"name":name,"value":None,
                                      "type":"folder","ns":ns_idx,"writable":None})
                    ext = "    " if last else "│   "
                    await tree_browse(child, prefix + ext, filter_ns)
                except:
                    pass
        except:
            pass

    try:
        ns_array = await client.get_namespace_array()
        print("\n[*] Namespaces:")
        for i, ns in enumerate(ns_array):
            marker = " ◄" if ns_filter is not None and i == ns_filter else ""
            print(f"  [{i}] {ns}{marker}")

        if ns_filter is not None:
            print(f"\n[*] Node Tree (ns={ns_filter}):")
            root     = client.get_objects_node()
            children = await root.get_children()
            found    = False
            for child in children:
                if child.nodeid.NamespaceIndex == ns_filter:
                    found = True
                    name   = (await child.read_browse_name()).Name
                    nodeid = child.nodeid.to_string()
                    print(f"└── [{nodeid}] {name}/")
                    await tree_browse(child, "    ", ns_filter)
            if not found:
                await tree_browse(client.get_objects_node(), "", ns_filter)
        else:
            print("\n[*] Node Tree (all namespaces):")
            root     = client.get_objects_node()
            children = await root.get_children()
            for child in children:
                name   = (await child.read_browse_name()).Name
                nodeid = child.nodeid.to_string()
                print(f"└── [{nodeid}] {name}/")
                await tree_browse(child, "    ")

    finally:
        try:
            await client.disconnect()
        except:
            pass

    if output:
        with open(output, "w") as f:
            json.dump(nodes, f, indent=2)
        print(f"\n[+] Saved {len(nodes)} nodes → {output}")

    return nodes


# ─── Mode 4: Check writable nodes ────────────────────────────────────────────

async def mode_writable(url, user="", password="", cert=None, key=None, security="none", ns_filter=None):
    ns_info = f" (ns={ns_filter})" if ns_filter is not None else ""
    print(f"\n{bold(blue("[*]"))} Checking {green("writable")} nodes on {cyan(url)}{ns_info}")
    print(f"{'─'*50}")

    client = await _connect_by_security(url, security, cert, key, user, password)
    if not client:
        print("[-] Connection failed")
        return

    writable = []

    async def check_write(node, in_ns=False):
        try:
            children = await node.get_children()
            for child in children:
                try:
                    ns_idx = child.nodeid.NamespaceIndex
                    name   = (await child.read_browse_name()).Name
                    nodeid = child.nodeid.to_string()

                    # ถ้ามี ns_filter: ต้องอยู่ใน ns ที่ถูกต้อง
                    # in_ns=True = อยู่ใต้ parent ที่ ns ตรงแล้ว
                    matched = (ns_filter is None) or (ns_idx == ns_filter) or in_ns

                    if not matched:
                        # ลงไปหา node ที่ ns ตรงใน subtree ต่อ
                        await check_write(child, in_ns=False)
                        continue

                    try:
                        val = await child.read_value()
                        try:
                            dv = await child.read_data_value()
                            await child.write_value(dv)
                            print(f"  {green("[W]")} {cyan(nodeid)} {bold(name)} = {neon(repr(val))}")
                            writable.append({"nodeid":nodeid,"name":name,"value":str(val)})
                        except:
                            print(f"  {yellow("[R]")} {cyan(nodeid)} {name} = {repr(val)}")
                    except:
                        print(f"  {blue("[F]")} {cyan(nodeid)} {blue(name+"/")}")

                    # ลงลึกต่อ — ถ้า ns ตรงแล้ว force in_ns=True ทั้ง subtree
                    await check_write(child, in_ns=(ns_filter is None or ns_idx == ns_filter or in_ns))
                except:
                    pass
        except:
            pass

    try:
        await check_write(client.get_objects_node(), in_ns=False)
    finally:
        try:
            await client.disconnect()
        except:
            pass

    print(f"\n{green("[+]")} Found {bold(str(len(writable)))} writable node(s)")
    for w in writable:
        print(f"  {green("[W]")} {cyan(w['nodeid'])} {bold(w['name'])} = {neon(w['value'])}")
    return writable


# ─── Mode 5: Read node ────────────────────────────────────────────────────────

async def mode_read(url, nodeid, user="", password="", cert=None, key=None, security="none"):
